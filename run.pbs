#!/bin/bash
#PBS -N a3
#PBS -P col7880.cs1230459.course
#PBS -l select=1:ncpus=16:mpiprocs=16
#PBS -l walltime=00:30:00
#PBS -o run.log
#PBS -j oe

set -uo pipefail
cd $HOME/Assignment_3

module load compiler/gcc/9.1.0
module load compiler/gcc/9.1/openmpi/4.1.2

make all
./seq input.txt output.txt
mpirun -np 16 ./main input.txt output.txt